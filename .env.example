# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── DynamoDB (leave DYNAMODB_ENDPOINT blank to use real AWS DynamoDB) ─────────
DYNAMODB_ENDPOINT=http://localhost:8000

# ── Cognito ───────────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=mini-jira-attachments
S3_RESIZED_BUCKET_NAME=mini-jira-attachments-resized

# ── SNS / SQS ─────────────────────────────────────────────────────────────────
# Fan-out topic for task assignment events (email + SQS)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:mini-jira-assignments
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/mini-jira-assignments

# Daily digest topic (separate from assignment topic)
SNS_DAILY_DIGEST_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:mini-jira-digest

# ── Lambda env vars (set these in the Lambda function configuration) ──────────
# TASKS_TABLE=Tasks
# ACTIVITY_LOG_TABLE=ActivityLog
# S3_BUCKET_NAME=mini-jira-attachments
# S3_RESIZED_BUCKET_NAME=mini-jira-attachments-resized
# SNS_DAILY_DIGEST_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:mini-jira-digest
