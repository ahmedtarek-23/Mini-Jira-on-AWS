# AWS Region
AWS_REGION=us-east-1

# DynamoDB Local endpoint — leave blank or remove to use real AWS DynamoDB
DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito — fill in after creating your User Pool in the AWS console
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Express server port
PORT=3000
