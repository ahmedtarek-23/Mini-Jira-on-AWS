{
  "name": "mini-jira-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --packages=external",
    "build:deploy": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js",
    "build:lambdas": "tsx scripts/build-lambdas.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.777.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.777.0",
    "@aws-sdk/client-dynamodb": "^3.777.0",
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/client-sns": "^3.777.0",
    "@aws-sdk/lib-dynamodb": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "aws-jwt-verify": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jose": "^6.0.8",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.11",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
